<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JMP Printshop All Products</title>

    <style>

        .page-main{
           max-width:100vw !important;
          }

        .hidden-mid-section{
            margin-bottom: 60px;
        }

        .alternative-mid-section{
            background-color: #003544;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card-heading-text h2{
            display: flex;
            align-items: center;
            justify-content: center;
            color: black;
            text-decoration: underline;
            font-size: 30px;
        }

        .card-all-products h3{
            display: flex;
            align-items: center;
            justify-content: center;
            color: rgb(0, 0, 0)!important;
            font-size: 45px;
            margin-top: 20px;
            padding-bottom: 10px; 
            font-weight: bold;
            text-decoration: capitalize;
        }

        .cardholder {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            width: 100vw;
            padding-bottom: 40px;

        }

        .card {
            display: inline-block;
            background-color: transparent;
            color: #003544;
            height: 20vh;
            min-width: 15vw;
            margin-left: 2vw;
            margin-right: 2vw;
            border: 1px solid rgba(0, 0, 0, 0.381);
            border-radius: 10px;
            transition: border 0.5s ease-out, box-shadow 0.4s ease-out;
            transition: transform 0.3s ease-in-out;
        }

        .card:hover {
            border: 3px solid #e6007e !important;
            box-shadow: 13px 13px 13px #00000048;
            transform: scale(1.2);
            cursor: pointer;
        }

        .card img {
        object-fit:contain;
            width: 100%;
            height: 100%;
            border-radius: 10px;
        }


        .static-card {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center; 
            position: relative;
            max-width: 25vw; 
            margin: 3vw;
            padding-top: none ;
            padding-bottom: 2vh ;
            padding-left: none;
            padding-right: none;
            height: 80%; 
            border: 1px solid #c1c1c1;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.525);

        }
        .static-card img {
        object-fit:cover;
            width: 100%;
            height: auto;
        }

        /*Mobile Media*/

        @media (max-width: 768px) {
        h2{
            font-size: 15px;
        }
        h1{
            font-size: 22px;
        }
        li.custom-list-item {
            color: white;
            font-size: 11px;
            padding: 0;
        }
        span.custom-text {
            color: #ffffff;
            font-size: 11px;
            padding: 0;
            margin: 0;
        }
        span.custom-number {
            display: none;
        }       
        .cardholder {
            flex-direction: column;
            align-items: center;
        }
        .card {
            width: 80%;
            margin-top:30px;
        }
        
        .card:hover {
            transform: none !important;
        }

        .card-heading-text h2{
            font-size: 22px;
        }

        .static-card {
            width: 80%;
            max-width: 40vw; 
        }
        }

        /*End Mobile Media*/

    </style>

</head>
<body>
        <div class="hidden-mid-section">
                <div class="card-all-products">
                    <h3>Notebook/Diary</h3>
                </div>
                <div class="cardholder">
                    <button class="card" onclick="window.location.href='https://jmp-printshop.com/all-products/commercial-printing/letter-heads.html';">
                        <img src="https://jmp-printshop.com/pub/media/wysiwyg/Letterheads_mockup.jpg" alt="Letterheads">
                        <h2>Notebook</h2>
                    </button>
                    <button class="card" onclick="window.location.href='https://jmp-printshop.com/all-products/commercial-printing/business-cards.html';">
                        <img src="https://jmp-printshop.com/pub/media/wysiwyg/BC_mockup_fin.png" alt="Business Cards">
                        <h2>Diary</h2>
                    </button>
                </div>
        </div>
</body>
</html>


