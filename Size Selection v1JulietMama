<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Website</title>
    <style>

        #cards {
            display: grid;
            gap: none;
            grid-template-columns: repeat(3, 1fr);
            max-width: 100%;
            max-height: 100%;
            padding: 1em 0em;
            place-self: center;
            position: relative;
            width: calc(100% - 0em);
            z-index: 2;
        }

        .card {
            background-color: var(--card-color);
            border-radius: 0px;
            max-width: 100%;
            min-height: 100%;
            position: relative;
        }

        .card:hover:before {
            opacity: 1;
        }

        .card-content {
            background-color: var(--card-color);
            border-radius: inherit;
            display: grid;
            inset: 1px;
            padding: 0em;
            position: absolute;
            height: 100%;
            width: 100%;
        }

        .outer-con-a {
            display: flex;
            justify-content: center;
            align-items: center;
            max-width: 100%;
            max-height: 100%;
            border: 2px #000;
        }

        .outer-con-b {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-content: center;
            max-height: 100%;
            max-width: 100%;
            border: 2px ;
        }

        .inner-con {
            padding: 1px;
            margin: 1px;
        }

        .inner-con.card:hover:before {
            border: 1px solid #000;
            padding: 2px;
            margin: 2px;
        }


        .inner-con-a3 {
            width: 20em;
            height: 12em;
        }

        .inner-con-300x300 {
            width: 12.9em;
            height: 11.4em;
        }

        .inner-con-a4 {
            width: 10.5em;
            height: 7.9em;
        }

        .inner-con-a5 {
            width: 7.9em;
            height: 4.8em;
        }

        button.cardbutton {
            background-color: rgb(0, 53, 68);
            color: #e6007e;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            z-index: 5;
            width: 100%;
            height: 100%;
            max-height: 100%;
            max-width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            transform-origin: center;
            transition: transform 0.4s ease;
            position: relative;
            border:2px;
        }

        button.cardbutton:hover {
            background-color: #e6007e;
            transform: scale(110%);
            z-index:10;
            
        }

        button.cardbutton span {
            display:block;
            white-space: wrap;
            text-decoration: none;
            color: #e6007e;
            font-size: 30px;

        }

        button.cardbutton:hover span {
            transform: none;
            color:rgb(0, 53, 68);
        }

    </style>
</head>
<body>
    <div class="outer-con-a">
        <div class="outer-con-b">
            <div class="inner-con inner-con-a3">
                <button class="cardbutton" onclick="window.location.href='https://jmp-printshop.com/photobooks-online-a3.html';">
                    <span>A3</span>
                </button>
            </div>
            <div class="inner-con inner-con-300x300">
                <button class="cardbutton" onclick="window.location.href='https://jmp-printshop.com/photobooks-online-300x300.html';">
                        <span>300x300</span>
                </button>
            </div>
            <div class="inner-con inner-con-a4">
                <button class="cardbutton" onclick="window.location.href='https://jmp-printshop.com/photobooks-online-a4.html';">
                    <span>A4</span>
                </button>
            </div>
            <div class="inner-con inner-con-a5">
                <button class="cardbutton" onclick="window.location.href='https://jmp-printshop.com/photobooks-online-a5.html';">
                    <span>A5</span>
                </button>
            </div>
        </div>
    </div>
</body>
</html>
